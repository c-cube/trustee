(dirs :standard _webui)

(executable
 (name trustee_ot)
 (flags :standard -warn-error -a+8 -open Trustee_core.Sigs)
 (libraries
  containers
  unix
  trustee.core
  trustee_minidag
  trace-tef
  opentelemetry
  opentelemetry.trace
  opentelemetry-client-ocurl
  logs
  trustee-opentheory
  tiny_httpd
  tiny_httpd.prometheus
  tiny_httpd_camlzip))

(rule
 (targets static.ml)
 (deps
  (:css main.css)
  (:uijs _webui/trustee-ui.js)
  (:map _webui/trustee-ui.js.map)
  (:symbols ../../../assets/symbols.json))
 (action
  (run
   tiny-httpd-vfs-pack
   --file=main.css,%{css}
   --file=trustee-ui.js,%{uijs}
   --file=trustee-ui.js.map,%{map}
   --file=symbols.json,%{symbols}
   --url=bootstrap.css,https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css
   --url=htmx.js,https://unpkg.com/htmx.org@1.7.0/dist/htmx.min.js
   -o
   %{targets})))
